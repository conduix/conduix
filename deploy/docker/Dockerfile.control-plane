# Build stage
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder

ARG TARGETOS TARGETARCH

WORKDIR /app

# 의존성 설치
RUN apk add --no-cache git

# Go 모듈 복사 및 다운로드 (캐시 마운트)
COPY shared/go.mod shared/go.sum ./shared/
COPY pipeline-core/go.mod pipeline-core/go.sum ./pipeline-core/
COPY plugin-sdk/go.mod ./plugin-sdk/
COPY control-plane/go.mod control-plane/go.sum ./control-plane/

WORKDIR /app/control-plane
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# 소스 코드 복사
WORKDIR /app
COPY shared ./shared
COPY pipeline-core ./pipeline-core
COPY plugin-sdk ./plugin-sdk
COPY control-plane ./control-plane

# 빌드 (네이티브 크로스 컴파일 + 캐시 마운트)
WORKDIR /app/control-plane
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-s -w" -o /app/control-plane-server ./cmd/server

# Runtime stage
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /app/control-plane-server .

EXPOSE 8080

ENTRYPOINT ["./control-plane-server"]
CMD ["--migrate"]
