# Build stage
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder

ARG TARGETOS TARGETARCH

WORKDIR /app

# 의존성 설치
RUN apk add --no-cache git

# gopls 설치 (LSP 자동완성 서버)
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOBIN=/usr/local/bin go install golang.org/x/tools/gopls@latest

# Go 모듈 복사 및 다운로드 (캐시 마운트)
COPY shared/go.mod shared/go.sum ./shared/
COPY pipeline-core/go.mod pipeline-core/go.sum ./pipeline-core/
COPY plugin-sdk/go.mod ./plugin-sdk/
COPY control-plane/go.mod control-plane/go.sum ./control-plane/

WORKDIR /app/control-plane
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# 소스 코드 복사
WORKDIR /app
COPY shared ./shared
COPY pipeline-core ./pipeline-core
COPY plugin-sdk ./plugin-sdk
COPY control-plane ./control-plane

# 빌드 (네이티브 크로스 컴파일 + 캐시 마운트)
WORKDIR /app/control-plane
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -ldflags="-s -w" -o /app/control-plane-server ./cmd/server

# Runtime stage — golang 이미지 사용 (go build + gopls 필요)
# TestNativePlugin에서 서버 사이드 go build 수행
# gopls LSP 서버로 자동완성 제공
FROM golang:1.26-alpine

RUN apk --no-cache add ca-certificates tzdata git

WORKDIR /app

# control-plane 바이너리
COPY --from=builder /app/control-plane-server .

# gopls 바이너리
COPY --from=builder /usr/local/bin/gopls /usr/local/bin/gopls

# plugin-sdk 소스 (gopls workspace에서 참조)
COPY plugin-sdk /app/plugin-sdk

ENV CONDUIX_SDK_PATH=/app/plugin-sdk

EXPOSE 8080

# 기본은 서버 실행. 마이그레이션은 AUTO_MIGRATE=true(서버 기동 시) 또는
# migration Job(args: [--migrate], 완료 후 종료)이 담당한다.
# CMD로 --migrate를 주면 일반 pod가 마이그레이션만 하고 종료해버린다.
ENTRYPOINT ["./control-plane-server"]
